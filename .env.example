# Used by docker-compose. Copy to .env and change for anything beyond local use.

# Secret for signing JWTs (>= 32 bytes). Generate with: openssl rand -base64 48
JWT_SECRET="change-me-change-me-change-me-change-me"

# Host ports (change if something else already uses them)
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
